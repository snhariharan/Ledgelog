# Expense Tracker — Environment Variables
# Copy this file to .env and fill in your values
# Get these from: Supabase Dashboard → Project Settings → API Keys

# ── Supabase ───────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# ── Notes ──────────────────────────────────────────────────────────────────
# - Never commit .env to git (it's in .gitignore)
# - Use the PUBLISHABLE key (public), not the secret key (private)
# - If these are empty the app will run in demo mode using local mock data
